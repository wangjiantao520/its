# PostgreSQL runtime connection (use a pooled TLS URL in Coze)
DATABASE_URL=postgres://user:password@pooler.example.com:6543/postgres

# Per warm Vercel function instance. Leave unset to use 1 on Vercel and 10 elsewhere.
DATABASE_POOL_MAX=1

# Vercel Supabase TLS verification (base64 of the official prod-ca-2021.crt from Database Settings)
# SUPABASE_DB_CA_CERT_BASE64=

# Optional direct/session URL used only by schema migrations
DATABASE_MIGRATION_URL=postgres://user:password@database.example.com:5432/postgres

# Disposable PostgreSQL database used by integration tests
TEST_DATABASE_URL=postgres://user:password@test-database.example.com:5432/postgres

# Supabase Storage (the bucket must be created as private before upload features are used)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only. SUPABASE_SERVICE_ROLE_KEY is accepted for projects using legacy keys.
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_STORAGE_BUCKET=quote-library

# Optional AI override. If unset, the active model in ai_model_configs is used.
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_URL=
# DEEPSEEK_MODEL=
# DEEPSEEK_PROVIDER=

# 认证配置（生产环境必须设置）
# ITS成员密码
ITS_PASSWORD=replace_with_a_strong_password
# 管理员密码
ADMIN_PASSWORD=replace_with_a_different_strong_password
