# PostgreSQL runtime connection (use a pooled TLS URL in Coze)
DATABASE_URL=postgres://user:password@pooler.example.com:6543/postgres

# Optional direct/session URL used only by schema migrations
DATABASE_MIGRATION_URL=postgres://user:password@database.example.com:5432/postgres

# Disposable PostgreSQL database used by integration tests
TEST_DATABASE_URL=postgres://user:password@test-database.example.com:5432/postgres

# 认证配置（生产环境必须设置）
# ITS成员密码
ITS_PASSWORD=replace_with_a_strong_password
# 管理员密码
ADMIN_PASSWORD=replace_with_a_different_strong_password
